 // persists the user's settings onto their session
 function persistSettings(req, settings, done) {
+  // regenerate() starts an empty session, so carry the existing data
+  // (notably userId) over or the user ends up logged out
+  const { cookie, ...previous } = req.session;
   // regenerate the session id before writing new data
   req.session.regenerate((err) => {
     if (err) return done(err);
-    req.session.settings = settings;
+    Object.assign(req.session, previous, { settings });
     req.session.save(done);
   });
 }
